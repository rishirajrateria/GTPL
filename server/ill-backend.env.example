# Copy to /etc/ill-backend.env, fill in, then: chmod 600 /etc/ill-backend.env
# Generate the two required values on the server:
#   python3 /opt/ill-backend/ill_backend.py hash-password
#   python3 /opt/ill-backend/ill_backend.py secret
# Paste each printed line below exactly as printed (no quotes needed).

ILL_ADMIN_PASSWORD_HASH=
ILL_SECRET=

# Optional (defaults shown)
#ILL_DB=/var/lib/ill-backend/ill.db
#ILL_HOST=127.0.0.1
#ILL_PORT=8787
#ILL_RETENTION_DAYS=400

# Optional: e-mail an alert for every new lead
#ILL_NOTIFY_TO=sales@gtplkcbpl.com
#ILL_SMTP_HOST=smtp.example.com
#ILL_SMTP_PORT=587
#ILL_SMTP_STARTTLS=1
#ILL_SMTP_USER=alerts@gtplkcbpl.com
#ILL_SMTP_PASSWORD=
#ILL_SMTP_FROM=alerts@gtplkcbpl.com
