# /etc/systemd/system/ill-backend.service
# Lead capture + visitor analytics + /admin for ill.gtplkcbpl.com
[Unit]
Description=ILL landing page backend (leads, analytics, admin)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/ill-backend.env
ExecStart=/usr/bin/python3 /opt/ill-backend/ill_backend.py serve
Restart=on-failure
RestartSec=3

# Runs as a throwaway system user; the database lives in /var/lib/ill-backend
DynamicUser=yes
StateDirectory=ill-backend
StateDirectoryMode=0700
UMask=0077

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
